# Copy to .env on the host (never commit it). Full reference: DEPLOYMENT.md

JIRA_BASE_URL=https://kaseya.atlassian.net
JIRA_EMAIL=you@example.com
# Secret - Atlassian API token
JIRA_TOKEN=
JIRA_TARGET_QUARTER_FIELD=customfield_14106
JIRA_RAG_FIELD=customfield_14707

PROJECTS=ONP,OA
GATES=3,4,5

AUTH_ENABLED=true
# Secret - generate once with: openssl rand -hex 32 (must stay stable across restarts)
AUTH_SECRET=
